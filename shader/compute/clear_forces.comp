#version 430

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer Forces
{
    float forces[];
};

uniform int count;

void main()
{
    const uint mass = gl_GlobalInvocationID.x;
    if (mass >= uint(count)) {
        return;
    }

    forces[3 * mass + 0] = 0.0;
    forces[3 * mass + 1] = 0.0;
    forces[3 * mass + 2] = 0.0;
}
