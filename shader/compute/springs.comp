#version 430

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer Forces
{
    float forces[];
};

layout(std430, binding = 1) readonly buffer Positions
{
    float positions[];
};

layout(std430, binding = 2) readonly buffer Velocities
{
    float velocities[];
};

layout(std430, binding = 3) readonly buffer AdjacencyOffsets
{
    uint adj_offsets[];
};

layout(std430, binding = 4) readonly buffer AdjacencyNeighbors
{
    uint adj_neighbors[];
};

uniform int count;
uniform float restLength;
uniform float springK;
uniform float dampeningK;

vec3 position_of(const uint i)
{
    return vec3(positions[3 * i + 0], positions[3 * i + 1], positions[3 * i + 2]);
}

vec3 velocity_of(const uint i)
{
    return vec3(velocities[3 * i + 0], velocities[3 * i + 1], velocities[3 * i + 2]);
}

void main()
{
    const uint mass = gl_GlobalInvocationID.x;
    if (mass >= uint(count)) {
        return;
    }

    const vec3 position = position_of(mass);
    const vec3 velocity = velocity_of(mass);

    vec3 force = vec3(0.0);
    const uint begin = adj_offsets[mass];
    const uint end = adj_offsets[mass + 1];
    for (uint entry = begin; entry < end; ++entry) {
        const uint other = adj_neighbors[entry];
        const vec3 delta = position - position_of(other);
        const vec3 delta_velocity = velocity - velocity_of(other);

        const float sq_len = dot(delta, delta);
        if (sq_len < 1e-12) {
            continue;
        }

        const float inv_len = inversesqrt(sq_len);
        const float len = sq_len * inv_len;
        if (len <= restLength) {
            continue;
        }

        const float hooke = springK * (len - restLength);
        const float dampening = dampeningK * dot(delta_velocity, delta) * inv_len;
        force += delta * (-(hooke + dampening) * inv_len);
    }

    forces[3 * mass + 0] = force.x;
    forces[3 * mass + 1] = force.y;
    forces[3 * mass + 2] = force.z;
}
