#version 430

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Histogram
{
    uint histogram[];
};

layout(std430, binding = 1) writeonly buffer Offsets
{
    uint offsets[];
};

uniform int blockCount;

shared uint totals[16];

void main()
{
    const uint bin = gl_LocalInvocationID.x;

    uint total = 0u;
    for (int block = 0; block < blockCount; ++block) {
        total += histogram[block * 16 + int(bin)];
    }
    totals[bin] = total;
    barrier();

    // Elements are ordered by bin, then by block, then by their position in the block. This
    // offset layout makes the scatter pass stable without any global atomics.
    uint global_prefix = 0u;
    for (uint lower = 0u; lower < bin; ++lower) {
        global_prefix += totals[lower];
    }

    uint running = global_prefix;
    for (int block = 0; block < blockCount; ++block) {
        const uint value = histogram[block * 16 + int(bin)];
        offsets[block * 16 + int(bin)] = running;
        running += value;
    }
}
