#version 430

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Positions
{
    float positions[];
};

layout(std430, binding = 1) writeonly buffer Elements
{
    // x = code bits 0..31, y = code bits 32.., z = mass id
    uvec4 elements[];
};

uniform int count;
uniform int depth;
uniform vec3 rootMin;
uniform vec3 rootMax;

uint quantize_axis(float coordinate, float box_min, float box_max, int bits)
{
    const float extent = box_max - box_min;
    if (extent <= 0.0) {
        return 0u;
    }

    float normalized = (coordinate - box_min) / extent;
    // std::nextafter(1.0f, 0.0f) on the CPU path.
    normalized = clamp(normalized, 0.0, 0.9999999403953552);
    const float grid_max = float((1u << uint(bits)) - 1u);
    return uint(normalized * grid_max);
}

void main()
{
    const uint id = gl_GlobalInvocationID.x;
    if (id >= uint(count)) {
        return;
    }

    const float px = positions[3 * id + 0];
    const float py = positions[3 * id + 1];
    const float pz = positions[3 * id + 2];

    const uint x = quantize_axis(px, rootMin.x, rootMax.x, depth);
    const uint y = quantize_axis(py, rootMin.y, rootMax.y, depth);
    const uint z = quantize_axis(pz, rootMin.z, rootMax.z, depth);

    // Interleave one bit per axis at a time. libmorton uses x in bit 0, y in bit 1,
    // z in bit 2, which this loop matches exactly.
    uint code_lo = 0u;
    uint code_hi = 0u;
    for (int bit = 0; bit < depth; ++bit) {
        const uint position = uint(3 * bit);
        if (((x >> uint(bit)) & 1u) != 0u) {
            if (position < 32u) {
                code_lo |= 1u << position;
            } else {
                code_hi |= 1u << (position - 32u);
            }
        }
        if (((y >> uint(bit)) & 1u) != 0u) {
            const uint p = position + 1u;
            if (p < 32u) {
                code_lo |= 1u << p;
            } else {
                code_hi |= 1u << (p - 32u);
            }
        }
        if (((z >> uint(bit)) & 1u) != 0u) {
            const uint p = position + 2u;
            if (p < 32u) {
                code_lo |= 1u << p;
            } else {
                code_hi |= 1u << (p - 32u);
            }
        }
    }

    elements[id] = uvec4(code_lo, code_hi, id, 0u);
}
