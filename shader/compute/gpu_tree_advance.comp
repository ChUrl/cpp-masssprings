#version 430

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Counters
{
    // 0: next node index, 1: next child slot, 2: unused, 3: next record index,
    // 4: root node index, 5: current ref count, 6: output ref count
    uint counters[];
};

void main()
{
    counters[5] = counters[6];
    counters[6] = 0u;
}
